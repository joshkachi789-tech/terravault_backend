# Copy this file to .env and fill in real values. Never commit .env to git.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=TerraVault"

# ─── Admin seed credentials ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@terravault.com
ADMIN_PASSWORD=your-strong-admin-password

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-long-random-jwt-secret"

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET="your-cron-bearer-token"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
